<?xml version="1.0" encoding="utf-8"?>
<!-- video-player-redesign：移除顶部导航栏与底部操作栏，重构为 播放器(固定顶部) + Tab栏 + 内容区 结构。
     播放器常驻顶部，切换Tab/线路/选集时不销毁不断流；全屏时隐藏Tab栏与内容区，仅留播放器。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- add-dlna-cast AD-05 兜底②：投屏中状态条（面板关闭后仍可见，点击回到投屏面板） -->
    <TextView
        android:id="@+id/dlna_cast_banner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/primary"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:textColor="@color/white"
        android:textSize="@dimen/text_14sp"
        android:visibility="gone"
        tools:text="正在投屏：客厅电视" />

    <FrameLayout
        android:id="@+id/layout_content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- R3 沉浸竖滑风格：ViewPager2 容器（垂直滑动切换视频，订阅源多文章模式） -->
        <LinearLayout
            android:id="@+id/viewPagerContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.viewpager2.widget.ViewPager2
                android:id="@+id/viewPager"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

        </LinearLayout>

        <!-- 传统布局（video-player-redesign：播放器固定顶部 + Tab栏 + 内容区） -->
        <LinearLayout
            android:id="@+id/legacyContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- 播放器容器：播放器 + 覆盖按钮（返回/更多） -->
            <FrameLayout
                android:id="@+id/player_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <io.legado.app.help.gsyVideo.VideoPlayer
                    android:id="@+id/playerView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:layout_height="220dp" />

                <!-- 播放器覆盖按钮：返回（左上） -->
                <ImageButton
                    android:id="@+id/btn_player_back"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="start|top"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/back"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/white" />

                <!-- 播放器覆盖按钮：更多菜单（右上，含投屏/画中画/下载/浮窗/设置等） -->
                <ImageButton
                    android:id="@+id/btn_player_more"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="end|top"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/more"
                    android:src="@drawable/ic_more_vert"
                    app:tint="@color/white" />

            </FrameLayout>

            <!-- Tab 标签栏：简介 / 推荐 / 换源 + 弹幕开关 / 收藏 -->
            <LinearLayout
                android:id="@+id/tab_bar"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@color/background_card"
                android:elevation="2dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="8dp">

                <TextView
                    android:id="@+id/tab_intro"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/tab_intro"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tab_recommend"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/tab_recommend"
                    android:textColor="@color/tv_text_summary"
                    android:textSize="@dimen/text_15sp" />

                <TextView
                    android:id="@+id/tab_source"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/tab_source"
                    android:textColor="@color/tv_text_summary"
                    android:textSize="@dimen/text_15sp" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btn_danmaku"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/danmaku"
                    android:src="@drawable/ic_danmaku"
                    app:tint="@color/primaryText" />

                <ImageButton
                    android:id="@+id/btn_favorite"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/favorite"
                    android:src="@drawable/ic_star_border"
                    app:tint="@color/primaryText" />

            </LinearLayout>

            <!-- 内容区：三 Tab 内容切换（简介/推荐/换源） -->
            <FrameLayout
                android:id="@+id/content_frame"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <!-- 简介 Tab：信息卡 + 线路 + 选集（可滚动） -->
                <androidx.core.widget.NestedScrollView
                    android:id="@+id/intro_scroll"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:fillViewport="true"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- 基础信息卡片：封面 + 标题/源标记/作者/简介 -->
                        <LinearLayout
                            android:id="@+id/data"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="8dp"
                            android:layout_marginEnd="12dp"
                            android:orientation="horizontal">

                            <io.legado.app.ui.widget.image.CoverImageView
                                android:id="@+id/iv_cover"
                                android:layout_width="104dp"
                                android:layout_height="148dp"
                                android:contentDescription="@string/img_cover"
                                android:scaleType="centerCrop"
                                android:src="@drawable/image_cover_default" />

                            <LinearLayout
                                android:id="@+id/info"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tv_name"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:ellipsize="end"
                                    android:includeFontPadding="false"
                                    android:maxLines="2"
                                    android:text="@string/book_name"
                                    android:textColor="@color/primaryText"
                                    android:textSize="@dimen/text_18sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:id="@+id/tv_source_tag"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:ellipsize="end"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:textColor="@color/tv_text_summary"
                                    android:textSize="@dimen/text_12sp"
                                    android:visibility="gone" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="4dp"
                                    android:gravity="center_vertical"
                                    android:orientation="horizontal">

                                    <TextView
                                        android:id="@+id/tv_author"
                                        android:layout_width="0dp"
                                        android:layout_height="wrap_content"
                                        android:layout_weight="1"
                                        android:ellipsize="end"
                                        android:includeFontPadding="false"
                                        android:maxLines="1"
                                        android:text="@string/author"
                                        android:textColor="@color/tv_text_summary"
                                        android:textSize="@dimen/text_12sp" />
                                </LinearLayout>

                                <androidx.core.widget.NestedScrollView
                                    android:id="@+id/scroll_view_r"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="8dp"
                                    android:scrollbars="none">
                                    <FrameLayout
                                        android:id="@+id/tv_intro_container"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content" />
                                </androidx.core.widget.NestedScrollView>

                            </LinearLayout>

                        </LinearLayout>

                        <!-- 线路选择区 -->
                        <LinearLayout
                            android:id="@+id/chapters_container"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <!-- 线路区块标题 -->
                            <TextView
                                android:id="@+id/tv_route_label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingStart="16dp"
                                android:paddingTop="12dp"
                                android:paddingBottom="4dp"
                                android:text="@string/video_section_routes"
                                android:textColor="@color/primaryText"
                                android:textSize="@dimen/text_14sp"
                                android:textStyle="bold"
                                android:visibility="gone" />

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/volumes"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clipToPadding="false"
                                android:orientation="horizontal"
                                android:paddingStart="12dp"
                                android:paddingTop="2dp"
                                android:paddingEnd="12dp"
                                android:paddingBottom="2dp"
                                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                            <!-- 选集区块标题：合集 + 查看全部 -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingStart="16dp"
                                android:paddingTop="12dp"
                                android:paddingBottom="4dp">

                                <TextView
                                    android:id="@+id/tv_episode_label"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/video_section_episodes"
                                    android:textColor="@color/primaryText"
                                    android:textSize="@dimen/text_14sp"
                                    android:textStyle="bold"
                                    android:visibility="gone" />

                                <TextView
                                    android:id="@+id/btn_view_all"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:paddingStart="8dp"
                                    android:paddingEnd="8dp"
                                    android:paddingTop="2dp"
                                    android:paddingBottom="2dp"
                                    android:text="@string/view_all"
                                    android:textColor="@color/primary"
                                    android:textSize="@dimen/text_12sp"
                                    android:visibility="gone" />
                            </LinearLayout>

                            <!-- 选集：横向滚动 -->
                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/chapters"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:clipToPadding="false"
                                android:orientation="horizontal"
                                android:paddingTop="2dp"
                                android:paddingBottom="12dp"
                                app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

                        </LinearLayout>

                    </LinearLayout>
                </androidx.core.widget.NestedScrollView>

                <!-- 推荐 Tab：同源相关推荐影视卡片网格 -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recommend_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:padding="8dp"
                    android:visibility="gone"
                    app:layoutManager="androidx.recyclerview.widget.GridLayoutManager" />

                <!-- 换源 Tab：其他源搜索该片名结果列表 -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/source_switch_list"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:padding="8dp"
                    android:visibility="gone"
                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />

            </FrameLayout><!-- content_frame end -->

        </LinearLayout><!-- legacyContainer end -->

    </FrameLayout>

</LinearLayout>
