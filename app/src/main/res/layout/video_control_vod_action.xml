<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:scrollbars="none"
    android:visibility="visible">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp">

        <TextView
            android:id="@+id/episode_list"
            style="@style/VideoControlAction"
            android:text="@string/video_episode_list_btn"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/intro_skip"
            style="@style/VideoControlAction"
            android:text="@string/video_intro_skip_btn"
            android:textColor="@android:color/white"
            android:visibility="visible"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/outro_skip"
            style="@style/VideoControlAction"
            android:text="@string/video_outro_skip_btn"
            android:textColor="@android:color/white"
            android:visibility="visible"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/video_quality"
            style="@style/VideoControlAction"
            android:text="@string/video_route_label"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/tv_ratio"
            style="@style/VideoControlAction"
            android:text="@string/video_ratio_button"
            android:textColor="@android:color/white" />

        <TextView
            android:id="@+id/playback_speed"
            style="@style/VideoControlAction"
            android:text="@string/video_speed"
            android:textColor="@android:color/white" />

        <include layout="@layout/video_control_sound_fullscreen" />

    </LinearLayout>
</HorizontalScrollView>
