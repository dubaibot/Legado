<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <RelativeLayout
        android:id="@+id/surface_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center" />

    <master.flame.danmaku.ui.widget.DanmakuView
        android:id="@+id/danmaku_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <RelativeLayout
        android:id="@+id/thumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:background="#000000"
        android:scaleType="fitCenter" />

    <include
        android:id="@+id/widget_container"
        layout="@layout/video_widget_vod" />

    <!-- Playback controls only; the lock lives in the right-side rail. -->
    <LinearLayout
        android:id="@+id/center_controls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/prev_episode"
            style="@style/VideoControlCircle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="36dp"
            android:contentDescription="@string/video_prev_episode_btn"
            android:background="@drawable/bg_control_circle"
            android:padding="10dp"
            android:src="@drawable/ic_skip_previous" />

        <ImageView
            android:id="@+id/start"
            android:layout_width="66dp"
            android:layout_height="66dp"
            android:contentDescription="@string/video_play"
            android:focusable="true"
            android:background="@drawable/bg_control_circle"
            android:scaleType="centerInside"
            android:src="@drawable/ic_play_24dp"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/next"
            style="@style/VideoControlCircle"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginStart="36dp"
            android:contentDescription="@string/video_next_episode_btn"
            android:background="@drawable/bg_control_circle"
            android:padding="10dp"
            android:src="@drawable/ic_skip_next" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/layout_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@drawable/bg_video_controls_bottom"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:visibility="invisible"
        tools:visibility="visible">

        <!-- 时间进度行：当前时间 | 进度条 | 总时长 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/current"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#ffffff" />

            <SeekBar
                android:id="@+id/progress"
                android:layout_width="0dp"
                android:layout_height="32dp"
                android:layout_weight="1"
                android:background="@null"
                android:max="100"
                android:maxHeight="4dp"
                android:minHeight="4dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:progressDrawable="@drawable/video_seek_progress"
                android:thumb="@drawable/video_seek_thumb" />

            <TextView
                android:id="@+id/total"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="#ffffff" />

        </LinearLayout>

        <include layout="@layout/video_control_vod_action" />

    </LinearLayout>

    <include
        android:id="@+id/right_control_container"
        layout="@layout/video_control_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true" />

    <!-- GSY 内部锁屏逻辑需要此视图（lockTouchLogic 无空值检查），隐藏占位，用户可见锁屏按钮为 right_lock -->
    <ImageView
        android:id="@+id/lock_screen"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/bottom_progressbar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:layout_alignParentBottom="true"
        android:max="100"
        android:progressDrawable="@drawable/bottom_progress_buffer" />

    <ImageView
        android:id="@+id/back_tiny"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="6dp"
        android:layout_marginTop="6dp"
        android:visibility="gone" />

    <moe.codeest.enviews.ENDownloadView
        android:id="@+id/loading"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:visibility="invisible" />

    <ImageView
        android:id="@+id/small_close"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:paddingStart="10dp"
        android:paddingTop="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/video_small_close"
        android:visibility="gone" />

    <RelativeLayout
        android:id="@+id/layout_top"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_alignParentTop="true"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="200dp"
            android:gravity="start|center_vertical"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@android:color/white"
            android:textSize="@dimen/text_18sp"
            tools:ignore="RtlSymmetry" />

        <LinearLayout
            android:id="@+id/top_action_container"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/player_favorite"
                style="@style/VideoControlNormalIcon"
                android:scaleType="centerInside"
                android:src="@drawable/ic_star_border"
                android:contentDescription="@string/favorite" />
            <TextView
                android:id="@+id/toggle_danmaku"
                style="@style/VideoControlTextAction"
                android:padding="12dp"
                android:drawableTop="@drawable/ic_player_danmaku"
                android:contentDescription="@string/video_danmaku_on"
                android:text="" />
            <ImageView
                android:id="@+id/player_float"
                style="@style/VideoControlNormalIcon"
                android:src="@drawable/ic_float_window"
                android:tint="@android:color/white"
                android:contentDescription="@string/float_window" />
            <ImageView
                android:id="@+id/player_menu"
                style="@style/VideoControlNormalIcon"
                android:scaleType="centerInside"
                android:src="@drawable/ic_menu"
                android:tint="@android:color/white"
                android:contentDescription="@string/menu" />
        </LinearLayout>

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/preview_layout"
        android:layout_width="@dimen/seek_bar_image"
        android:layout_height="100dp"
        android:layout_above="@+id/layout_bottom"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="30dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tip_view"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_centerInParent="true"
        android:layout_marginTop="50dp"
        android:alpha="0"
        android:background="@drawable/selector_fillet_btn_bg"
        android:elevation="4dp"
        android:gravity="center"
        android:padding="12dp"
        android:textColor="@android:color/white"
        android:visibility="invisible" />

</RelativeLayout>
