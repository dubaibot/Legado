<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Keep ImageView IDs for the existing image-resource updates. -->
    <FrameLayout android:layout_width="56dp" android:layout_height="48dp" android:layout_weight="1">
        <ImageView android:id="@+id/iv_mute"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@android:color/transparent"
            android:alpha="0"
            android:scaleType="centerInside" android:src="@drawable/ic_volume_off"
            android:clickable="true" android:focusable="true" android:contentDescription="@string/dlna_volume" />
        <TextView style="@style/VideoControlCaption" android:text="@string/dlna_volume" />
    </FrameLayout>
    <FrameLayout android:layout_width="56dp" android:layout_height="48dp" android:layout_weight="1">
        <ImageView android:id="@+id/fullscreen"
            android:layout_width="match_parent" android:layout_height="match_parent"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:tint="@android:color/transparent"
            android:alpha="0"
            android:scaleType="centerInside" android:src="@drawable/ic_player_fullscreen_bold"
            android:clickable="true" android:focusable="true" android:contentDescription="@string/video_fullscreen_btn" />
        <TextView style="@style/VideoControlCaption" android:text="@string/video_fullscreen_btn" />
    </FrameLayout>
</merge>
